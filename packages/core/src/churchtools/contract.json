  "group": {
    "method": "get",
    "path": "/api/groups/{groupId}",
    "query": [],
    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "information": {
              "type": "object",
              "properties": {
                "meetingTime": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 255
                    },
                    {
                      "type": "null"
