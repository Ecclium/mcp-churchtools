                  "type": "string",
                  "maxLength": 254
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "guid",
            "firstName",
            "lastName"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "simulatingUserId": {
              "type": "null"
            }
          }
        }
      },
      "required": [
        "data"
      ]
    }
  },
