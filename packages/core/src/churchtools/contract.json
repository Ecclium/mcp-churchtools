    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "guid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "firstName": {
              "type": "string",
              "maxLength": 255
            },
            "lastName": {
              "type": "string",
              "maxLength": 255
            },
            "email": {
              "anyOf": [
