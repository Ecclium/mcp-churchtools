# Beispiel für die Konfiguration über Umgebungsvariablen.
#
# Kopieren Sie diese Datei nach .env und passen Sie die Werte dort an. Die
# Datei .env gehört nie ins Repository. Tokens und andere Geheimnisse gehören
# weder in diese Datei noch in .env.
#
# Noch gibt es keinen lauffähigen Server, die Werte haben deshalb keine
# Wirkung. Die vollständige Referenz entsteht mit der ersten Version.

# true: Tools, die in ChurchTools schreiben, werden gar nicht erst angeboten.
READ_ONLY=true

# Maskierung von Personendaten: off, standard oder strict.
REDACTION=standard
