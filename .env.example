# Beispiel für die Konfiguration über Umgebungsvariablen (ADR 0055).
#
# Ecclium liest keine Datei .env. Übergeben Sie die Variablen über die
# Umgebung, etwa im Abschnitt «env» der Konfiguration Ihres KI-Assistenten.
# Jede Variable beginnt mit ECCLIUM_. Eine unbekannte oder falsch
# geschriebene Variable mit diesem Präfix bricht den Start ab.
#
# Tokens und andere Geheimnisse gehören nie in diese Datei. Das Token für
# ChurchTools liegt in einer eigenen Datei, die nur Ihr Benutzer lesen darf.
#
# «ecclium stdio» startet den Server über stdio für einen KI-Assistenten,
# siehe docs/betrieb/stdio.md. «ecclium config check» prüft die Werte
# vorher, ohne ChurchTools anzufragen.

# Adresse Ihrer ChurchTools-Instanz: nur https, ohne Pfad.
ECCLIUM_CHURCHTOOLS_URL=https://example.church.tools

# Absoluter Pfad zur Datei mit dem Login-Token des Dienstkontos. Die Datei
# gehört Ihrem Benutzer und hat die Rechte 600.
ECCLIUM_CHURCHTOOLS_TOKEN_FILE=/pfad/zur/token-datei

# Nur im Betrieb über stdio und mit einer Warnung bei jedem Start darf das
# Token stattdessen in ECCLIUM_CHURCHTOOLS_TOKEN stehen, nie zusammen mit
# ECCLIUM_CHURCHTOOLS_TOKEN_FILE.

# Anfragen je Minute an ChurchTools, die Ecclium höchstens sendet: eine ganze
# Zahl von 1 bis 500. Mehr Anfragen weist Ecclium selbst ab, mit der Wartezeit.
ECCLIUM_CHURCHTOOLS_REQUESTS_PER_MINUTE=300

# true: Tools, die in ChurchTools schreiben, werden gar nicht erst angeboten.
# false verlangt ECCLIUM_KEYS_DIR.
ECCLIUM_READ_ONLY=true

# Maskierung von Personendaten: standard, strict oder off. strict kürzt
# Nachnamen, ersetzt Kennungen von Personen durch Pseudonyme, prüft Freitext
# und braucht ECCLIUM_PSEUDONYM_KEY_FILE, aber nicht mit dem Toolset api.
# off nur im Betrieb über stdio, mit Warnung beim Start.
ECCLIUM_REDACTION=standard

# Nur mit der Maskierung strict: absoluter Pfad einer Datei mit dem Schlüssel
# für Pseudonyme, 64 Zeichen aus 0 bis 9 und a bis f, wie ihn
# openssl rand -hex 32 schreibt, mit den Rechten 600. Wer ihn hat, übersetzt
# jedes Pseudonym zurück. Sichern Sie ihn. Beim Wechsel steht der neue
# Schlüssel in ECCLIUM_PSEUDONYM_KEY_FILE und der bisherige in
# ECCLIUM_PSEUDONYM_KEY_PREVIOUS_FILE, bis der UTC-Tag nach dem Wechsel vorbei
# ist.

# Die Bereiche von Tools, die Ecclium anbietet, mit Komma getrennt und ohne
# Leerzeichen: persons (Personen und Gruppen), events (Events und Dienste),
# calendars (Kalender, Termine, Ressourcen und Buchungen), wiki, songs und
# docs (Dokumentation von ChurchTools, ohne Zugriff auf die Instanz) und api
# (lesender Zugriff auf jede Operation der API, die Ecclium freigibt), oder
# all für alle ausser api, oder all,api für alle. Leer bietet Ecclium nur
# ct_whoami an. persons gibt Kennung und Name von Personen und Gruppen an
# den KI-Assistenten, api ganze Antworten von ChurchTools, der Start meldet
# beides, und beide verlangen ECCLIUM_STATE_DIR, sonst startet Ecclium nicht.
# Nur für eine Instanz, deren Daten der KI-Assistent sehen darf. Die Rechte
# des Dienstkontos dafür stehen in docs/betrieb/stdio.md unter «Suchtools».
ECCLIUM_TOOLSETS=

# Absoluter Pfad zum Ordner für den Zustand des Servers, empfohlen. Ecclium
# schreibt darin im Ordner audit eine Audit-Datei und erst danach eine Kopie
# jeder Zeile nach stderr, im Ordner quota zählt es die Aufrufe für das
# Lesebudget, und im Ordner snapshots legt es die Snapshots der
# Schreibvorgänge ab. Der Ordner gehört Ihrem Benutzer, hat die Rechte
# 700 und liegt lokal, nicht auf einem Netzlaufwerk und nicht in einem
# synchronisierten Ordner. Mit dem Toolset persons wird er nötig. Entfernen Sie
# die Zeile für den Betrieb ohne Audit-Datei, dann geht das Audit nur nach
# stderr.
ECCLIUM_STATE_DIR=/pfad/zum/zustandsordner

# Nur wenn Ecclium schreibt, und nur im Betrieb über stdio: In
# ECCLIUM_KEYS_DIR steht der absolute Pfad eines eigenen Ordners für die
# Tagesschlüssel, mit denen Ecclium die Snapshots der Schreibvorgänge und
# künftig die Freigabe-Warteschlange verschlüsselt. Der Start legt darin den
# Ordner snapshot an und vernichtet alte Schlüssel. Der Ordner gehört Ihrem
# Benutzer, hat die Rechte 700, liegt nicht im Zustandsordner, enthält ihn
# nicht und gehört in keine Sicherung. Nach 30 Tagen
# vernichtet Ecclium den Tagesschlüssel eines Tages, danach lässt sich ein
# Snapshot dieses Tages in keiner Kopie mehr lesen.

# Snapshots der Schreibvorgänge: on oder off. Mit on hält Ecclium vor jedem
# Schreibvorgang den bisherigen Stand in einem verschlüsselten Snapshot im
# Zustandsordner fest, für eine feste Frist von 30 Tagen, damit sich der
# Schreibvorgang zurücknehmen lässt. Snapshots entstehen mit den
# Schreib-Tools und nur, wenn Ecclium schreibt. Mit off lässt sich kein
# Schreibvorgang zurücknehmen, und jeder Start mit ECCLIUM_READ_ONLY=false
# warnt.
ECCLIUM_SNAPSHOTS=on

# Wie Ecclium einen Schreibvorgang bestätigen lässt, bevor es schreibt:
# echo-allowed, elicitation-or-queue oder queue. Mit echo-allowed, der
# Voreinstellung über stdio, fragt Ecclium im Client nach, wenn der Client
# das kann, sonst gilt die Bestätigung mit ct_write_confirm, wenn sich der
# Schreibvorgang zurücknehmen lässt, sonst wartet er in der
# Freigabe-Warteschlange. elicitation-or-queue, die Voreinstellung über HTTP,
# bestätigt nie mit ct_write_confirm. Mit queue wartet jeder Schreibvorgang
# auf Ihre Freigabe mit ecclium queue approve. Über HTTP warnt jeder Start
# mit echo-allowed. In dieser Version gibt es die Rückfrage im Client und
# ct_write_confirm, noch nicht die Freigabe-Warteschlange und die
# Schreib-Tools: Was keiner dieser Wege bestätigen kann, wird nicht
# geschrieben.
ECCLIUM_WRITE_CONFIRMATION=echo-allowed

# Wie viele Monate die Audit-Dateien bleiben, von 1 bis 120. Danach löscht
# Ecclium sie im Ordner audit, nicht aber Ihre Kopien. Empfohlen sind
# mindestens 12 Monate, darunter warnt jeder Start. Ohne ECCLIUM_STATE_DIR
# bewirkt die Variable nichts.
ECCLIUM_AUDIT_RETENTION_MONTHS=12

# Absoluter Pfad einer Datei mit der Richtlinie im Format policy.v1, in YAML
# oder JSON, siehe docs/policy.md. Sie nennt die Ziele, auf die bestätigte
# Schreibvorgänge gehen dürfen, wie oft je Tag, und das Lesebudget. Die
# Datei gehört Ihrem Benutzer, und Gruppe und andere Benutzer dürfen sie
# nicht ändern, etwa mit den Rechten 644. Ohne ECCLIUM_POLICY_FILE gilt die
# Voreinstellung: Erlaubt ist, was das Dienstkonto darf, ausser bei Gruppen
# und Diensten, und das Lesebudget ist 200 Aufrufe je Tag.

# Neutrale Bezeichnung im Audit für den Betrieb über stdio, nie der Name
# einer Person: Kleinbuchstaben, Ziffern und Bindestriche, am Anfang ein
# Buchstabe, höchstens 32 Zeichen.
ECCLIUM_STDIO_SUBJECT=local-stdio

# Stufe der Logzeilen auf stderr: debug, info, warn oder error.
ECCLIUM_LOG_LEVEL=info
