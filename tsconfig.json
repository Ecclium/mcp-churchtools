    { "path": "./packages/runner/tsconfig.test.json" },
    { "path": "./packages/server/tsconfig.test.json" },
    { "path": "./packages/cli/tsconfig.test.json" },
    { "path": "./packages/testkit/tsconfig.test.json" },
    { "path": "./tests" }
  ]
}
